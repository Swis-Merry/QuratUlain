# Final approved domain (used for canonical URLs, sitemap, Open Graph). Falls back to the Vercel URL.
NEXT_PUBLIC_SITE_URL=

# Contact form delivery via Resend (https://resend.com)
RESEND_API_KEY=
# Comma-separated list of recipients for enquiries
CONTACT_TO_EMAIL=
# Verified sender, e.g. "Qurat Ul Ain Website <enquiries@your-domain.com>"
CONTACT_FROM_EMAIL=
